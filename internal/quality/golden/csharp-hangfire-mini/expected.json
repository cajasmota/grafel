{
  "fixture_name": "csharp-hangfire-mini",
  "language": "csharp",
  "description": "Minimal Hangfire project with IBackgroundJob consumers, BackgroundJob.Enqueue producers, RecurringJob.AddOrUpdate, and [AutomaticRetry]. Used by the extraction-quality benchmark to verify PRODUCES/CONSUMES edge emission for Hangfire.",
  "expected_entities": [
    { "name": "EmailJob", "kind": "SCOPE.Service", "source_file": "jobs/EmailJob.cs", "must_exist": true, "note": "Hangfire IBackgroundJob consumer." },
    { "name": "CleanupJob", "kind": "SCOPE.Service", "source_file": "jobs/EmailJob.cs", "must_exist": true, "note": "Hangfire IBackgroundJob consumer with AutomaticRetry." },
    { "name": "EmailService.SendConfirmation", "kind": "SCOPE.Operation", "source_file": "api/OrderController.cs", "must_exist": true, "note": "Producer: BackgroundJob.Enqueue()." },
    { "name": "daily-cleanup", "kind": "SCOPE.Pattern", "source_file": "api/OrderController.cs", "must_exist": true, "note": "Producer: RecurringJob.AddOrUpdate." },
    { "name": "IEmailService.SendNewsletter", "kind": "SCOPE.Operation", "source_file": "api/OrderController.cs", "must_exist": true, "note": "Producer: BackgroundJob.Enqueue<T>()." }
  ],
  "expected_relationships": [
    { "from_name": "OrderController", "from_kind": "SCOPE.Component", "from_file": "api/OrderController.cs",
      "kind": "CONTAINS", "to_name": "OrderController.PlaceOrder", "to_kind": "SCOPE.Operation", "to_file": "api/OrderController.cs",
      "must_exist": true,
      "note": "#6490 arm B. `class OrderController { void PlaceOrder(int orderId) }`." },
    { "from_name": "OrderController", "from_kind": "SCOPE.Component", "from_file": "api/OrderController.cs",
      "kind": "CONTAINS", "to_name": "OrderController.ConfigureRecurring", "to_kind": "SCOPE.Operation", "to_file": "api/OrderController.cs",
      "must_exist": true },

    { "from_name": "EmailJob", "from_kind": "SCOPE.Component", "from_file": "jobs/EmailJob.cs",
      "kind": "CONTAINS", "to_name": "EmailJob.Execute", "to_kind": "SCOPE.Operation", "to_file": "jobs/EmailJob.cs",
      "must_exist": true,
      "note": "`class EmailJob : IBackgroundJob { Task Execute(PerformContext ctx) }`." },
    { "from_name": "CleanupJob", "from_kind": "SCOPE.Component", "from_file": "jobs/EmailJob.cs",
      "kind": "CONTAINS", "to_name": "CleanupJob.Execute", "to_kind": "SCOPE.Operation", "to_file": "jobs/EmailJob.cs",
      "must_exist": true },
    { "from_name": "EmailJob", "from_kind": "SCOPE.Service", "from_file": "jobs/EmailJob.cs",
      "kind": "CONTAINS", "to_name": "EmailJob.Execute", "to_kind": "SCOPE.Operation", "to_file": "jobs/EmailJob.cs",
      "must_exist": true,
      "note": "The job-class view of the same declaration — the Hangfire framework pass emits a SCOPE.Service twin, and it must carry the CONTAINS too or the job entity is a leaf." },
    { "from_name": "CleanupJob", "from_kind": "SCOPE.Service", "from_file": "jobs/EmailJob.cs",
      "kind": "CONTAINS", "to_name": "CleanupJob.Execute", "to_kind": "SCOPE.Operation", "to_file": "jobs/EmailJob.cs",
      "must_exist": true },

    { "from_name": "OrderController.PlaceOrder", "from_kind": "SCOPE.Operation", "from_file": "api/OrderController.cs",
      "kind": "CALLS", "to_name": "EmailService.SendConfirmation", "to_kind": "SCOPE.Operation", "to_file": "api/OrderController.cs",
      "must_exist": true,
      "note": "`BackgroundJob.Enqueue(() => EmailService.SendConfirmation(orderId));` — the enqueued lambda body, extracted as a task_send site." },
    { "from_name": "OrderController.PlaceOrder", "from_kind": "SCOPE.Operation", "from_file": "api/OrderController.cs",
      "kind": "CALLS", "to_bare_name": "BackgroundJob.Enqueue",
      "must_exist": true,
      "note": "The Hangfire producer API itself; external, so a bare-name target is the correct shape." },
    { "from_name": "OrderController.ConfigureRecurring", "from_kind": "SCOPE.Operation", "from_file": "api/OrderController.cs",
      "kind": "CALLS", "to_name": "IEmailService.SendNewsletter", "to_kind": "SCOPE.Operation", "to_file": "api/OrderController.cs",
      "must_exist": true,
      "note": "`BackgroundJob.Enqueue<IEmailService>(x => x.SendNewsletter());`." },
    { "from_name": "OrderController.ConfigureRecurring", "from_kind": "SCOPE.Operation", "from_file": "api/OrderController.cs",
      "kind": "CALLS", "to_bare_name": "RecurringJob.AddOrUpdate",
      "must_exist": true,
      "note": "`RecurringJob.AddOrUpdate(\"daily-cleanup\", () => CleanupService.Run(), Cron.Daily);`." },

    { "from_name": "api/OrderController.cs", "from_kind": "SCOPE.Component", "from_file": "api/OrderController.cs",
      "kind": "IMPORTS", "to_bare_name": "Hangfire",
      "must_exist": true,
      "note": "`using Hangfire;`." },
    { "from_name": "jobs/EmailJob.cs", "from_kind": "SCOPE.Component", "from_file": "jobs/EmailJob.cs",
      "kind": "IMPORTS", "to_bare_name": "Hangfire",
      "must_exist": true },

    { "from_name": "api/OrderController.cs", "from_kind": "SCOPE.Component", "from_file": "api/OrderController.cs",
      "kind": "CONTAINS", "to_name": "daily-cleanup", "to_kind": "SCOPE.Pattern", "to_file": "api/OrderController.cs",
      "must_exist": true,
      "note": "The recurring-job registration is anchored on the file that declares it." },

    { "from_name": "hangfire_recurring:daily-cleanup", "from_kind": "SCOPE.ScheduledJob", "from_file": "api/OrderController.cs",
      "kind": "TRIGGERS", "to_bare_name": "CleanupService.Run",
      "must_exist": false, "nice_to_have": true,
      "note": "#6490 arm B FINDING: the TRIGGERS edge IS emitted, but its target is the bare name `Run` — the receiver `CleanupService` is dropped from `() => CleanupService.Run()`. A one-word target collides with every other `Run` in a real repo, which is the #6499 class-qualification defect in the Hangfire producer path." },
    { "from_name": "EmailJob", "from_kind": "SCOPE.Service", "from_file": "jobs/EmailJob.cs",
      "kind": "IMPLEMENTS", "to_bare_name": "IBackgroundJob",
      "must_exist": false, "nice_to_have": true,
      "note": "#6490 arm B FINDING: `class EmailJob : IBackgroundJob` emits no IMPLEMENTS edge — C# emits no class-hierarchy edges at all here (same gap as csharp-aspnet-core-mini's UserService : IUserService)." },
    { "from_name": "OrderController.PlaceOrder", "from_kind": "SCOPE.Operation", "from_file": "api/OrderController.cs",
      "kind": "PRODUCES", "to_name": "EmailJob", "to_kind": "SCOPE.Service", "to_file": "jobs/EmailJob.cs",
      "must_exist": false, "nice_to_have": true,
      "note": "#6490 arm B FINDING, and the sharpest one in this fixture: its description says it exists \"to verify PRODUCES/CONSUMES edge emission for Hangfire\", and the graph contains ZERO PRODUCES and ZERO CONSUMES edges. Producer call sites and consumer job classes are two disconnected islands. Kept nice_to_have because binding an Enqueue lambda to the job class that services it is genuinely unimplemented, not merely mis-targeted." }
  ]
}
