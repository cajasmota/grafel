    { "name": "fetchAll", "kind": "SCOPE.Operation", "source_file": "Sources/App/UserService.swift", "must_exist": true },
    { "name": "fetchUser", "kind": "SCOPE.Operation", "source_file": "Sources/App/UserService.swift", "must_exist": true },
