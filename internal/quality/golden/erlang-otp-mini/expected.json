{
  "fixture_name": "erlang-otp-mini",
  "language": "erlang",
  "description": "Minimal OTP application: a gen_server cache, a supervisor, and an application callback. Exercises module/function/record extraction, include-based IMPORTS, OTP behaviour callbacks, and CONTAINS edges from module to exported functions.",
  "expected_entities": [
    { "name": "cache_server", "kind": "SCOPE.Component", "source_file": "cache_server.erl", "must_exist": true, "note": "gen_server module." },
    { "name": "start_link",   "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true, "note": "Public API." },
    { "name": "get",          "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "put",          "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "delete",       "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "flush",        "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "init",         "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true, "note": "gen_server callback." },
    { "name": "handle_call",  "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "handle_cast",  "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "handle_info",  "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "terminate",    "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },
    { "name": "code_change",  "kind": "SCOPE.Operation", "source_file": "cache_server.erl", "must_exist": true },

    { "name": "cache_sup",    "kind": "SCOPE.Component", "source_file": "cache_sup.erl", "must_exist": true, "note": "Supervisor module." },
    { "name": "start_link",   "kind": "SCOPE.Operation", "source_file": "cache_sup.erl", "must_exist": true },
    { "name": "init",         "kind": "SCOPE.Operation", "source_file": "cache_sup.erl", "must_exist": true },

    { "name": "cache_app",    "kind": "SCOPE.Component", "source_file": "cache_app.erl", "must_exist": true, "note": "Application callback module." },
    { "name": "start",        "kind": "SCOPE.Operation", "source_file": "cache_app.erl", "must_exist": true },
    { "name": "stop",         "kind": "SCOPE.Operation", "source_file": "cache_app.erl", "must_exist": true },

    { "name": "cache_entry",  "kind": "SCOPE.Component", "source_file": "cache.hrl", "must_exist": true, "note": "Record definition." },
    { "name": "cache_stats",  "kind": "SCOPE.Component", "source_file": "cache.hrl", "must_exist": true, "note": "Record definition." }
  ],
  "expected_relationships": [
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "get", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true,
      "note": "#6490 arm B. `-module(cache_server).` … `get(Key) -> …` — module owns its exported function." },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "put", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "delete", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "flush", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "start_link", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "handle_call", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true,
      "note": "gen_server callback — the -behaviour(gen_server) callbacks are contained by the module just like the exported API." },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "handle_cast", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "handle_info", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "terminate", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "code_change", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "CONTAINS", "to_name": "init", "to_kind": "SCOPE.Operation", "to_file": "cache_server.erl",
      "must_exist": true },

    { "from_name": "cache_sup", "from_kind": "SCOPE.Component", "from_file": "cache_sup.erl",
      "kind": "CONTAINS", "to_name": "start_link", "to_kind": "SCOPE.Operation", "to_file": "cache_sup.erl",
      "must_exist": true,
      "note": "Two modules export start_link/0; the from_file/to_file narrowing keeps them apart." },
    { "from_name": "cache_sup", "from_kind": "SCOPE.Component", "from_file": "cache_sup.erl",
      "kind": "CONTAINS", "to_name": "init", "to_kind": "SCOPE.Operation", "to_file": "cache_sup.erl",
      "must_exist": true },
    { "from_name": "cache_app", "from_kind": "SCOPE.Component", "from_file": "cache_app.erl",
      "kind": "CONTAINS", "to_name": "start", "to_kind": "SCOPE.Operation", "to_file": "cache_app.erl",
      "must_exist": true },
    { "from_name": "cache_app", "from_kind": "SCOPE.Component", "from_file": "cache_app.erl",
      "kind": "CONTAINS", "to_name": "stop", "to_kind": "SCOPE.Operation", "to_file": "cache_app.erl",
      "must_exist": true },

    { "from_name": "cache_sup", "from_kind": "SCOPE.Component", "from_file": "cache_sup.erl",
      "kind": "SUPERVISES", "to_name": "cache_server", "to_kind": "SCOPE.Component", "to_file": "cache_server.erl",
      "must_exist": true,
      "note": "cache_sup's init/1 ChildSpecs declares `#{id => cache_server, start => {cache_server, start_link, []}, modules => [cache_server]}`. This is the one edge in the fixture that reads the OTP supervision tree out of a literal map." },

    { "from_name": "get", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "gen_server:call",
      "must_exist": true,
      "note": "`get(Key) -> gen_server:call(?SERVER, {get, Key}).` — gen_server is OTP, so an external bare-name target is correct." },
    { "from_name": "put", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "gen_server:cast",
      "must_exist": true },
    { "from_name": "delete", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "gen_server:cast",
      "must_exist": true },
    { "from_name": "flush", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "gen_server:cast",
      "must_exist": true },
    { "from_name": "handle_cast", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "maps:remove",
      "must_exist": true,
      "note": "`handle_cast({delete, Key}, State) -> NewState = maps:remove(Key, State)`." },
    { "from_name": "init", "from_kind": "SCOPE.Operation", "from_file": "cache_server.erl",
      "kind": "CALLS", "to_bare_name": "maps:new",
      "must_exist": true,
      "note": "`init([]) -> State = maps:new()`." },

    { "from_name": "start", "from_kind": "SCOPE.Operation", "from_file": "cache_app.erl",
      "kind": "CALLS", "to_name": "start_link", "to_kind": "SCOPE.Operation", "to_file": "cache_sup.erl",
      "must_exist": false, "nice_to_have": true,
      "note": "#6490 arm B FINDING: `start(_StartType, _StartArgs) -> cache_sup:start_link().` calls a function that IS in this fixture, and the edge is emitted as the dangling bare name `cache_sup:start_link` instead of binding to cache_sup.erl's start_link/0. Erlang cross-module calls are never resolved to in-repo functions, so the whole application → supervisor call path is invisible. Held nice_to_have and reported rather than pinned to the bare name, which would ratify the resolution failure (#6441)." },
    { "from_bare_name": "cache_server.erl",
      "kind": "IMPORTS", "to_name": "cache.hrl", "to_kind": "SCOPE.Component", "to_file": "cache_server.erl",
      "must_exist": true,
      "note": "#6488 arm C: `-include(\"cache.hrl\").` emits an IMPORTS edge whose FROM side is the raw string \"cache_server.erl\" — no entity's ID — so until from_bare_name existed no expectation could address it, and MEASURED: deleting the producer in internal/extractors/erlang/extractor.go left this fixture's report byte-identical. Held as must_exist now that the carrier itself is addressable; from_resolved stays FALSE on this row, which is the finding, not a defect in the row. Erlang is NOT alone in lacking a file carrier — nim (internal/extractors/nim/nim.go) and groovy (internal/extractors/groovy/groovy.go) anchor imports on the path with no extractor.FileEntity either; emitting one for all three is #6815, and when it lands this row must move back to from_name + from_kind because the edge will then hang off an entity ID." },
    { "from_name": "cache_server", "from_kind": "SCOPE.Component", "from_file": "cache_server.erl",
      "kind": "IMPLEMENTS", "to_bare_name": "gen_server",
      "must_exist": true,
      "note": "#6370 FIXED: `-behaviour(gen_server).` now emits an IMPLEMENTS edge from the module entity to the bare behaviour atom, alongside the Properties[\"otp_behaviour\"] stamping it already did. Promoted from the nice_to_have row #6490 arm B left waiting." },
    { "from_name": "cache_sup", "from_kind": "SCOPE.Component", "from_file": "cache_sup.erl",
      "kind": "IMPLEMENTS", "to_bare_name": "supervisor",
      "must_exist": true,
      "note": "#6370: the second of the fixture's three -behaviour declarations. Held here so the edge is graded on more than the gen_server atom — a predicate hard-coded to gen_server would satisfy the row above and fail this one." },
    { "from_name": "cache_app", "from_kind": "SCOPE.Component", "from_file": "cache_app.erl",
      "kind": "IMPLEMENTS", "to_bare_name": "application",
      "must_exist": true,
      "note": "#6370: the third -behaviour declaration. All three modules in this fixture declare a behaviour, so all three are graded." }
  ],
  "forbidden_relationships": [
    { "from_bare_name": "cache_sup.erl",
      "kind": "IMPORTS", "to_name": "cache.hrl", "to_kind": "SCOPE.Component", "to_file": "cache_server.erl",
      "note": "#6488 arm C over-firing control. Only cache_server.erl carries `-include(\"cache.hrl\")`; cache_sup.erl includes nothing. An include edge is anchored on the file that wrote it, so this row must report ZERO hits — and it goes red both if the extractor mis-anchors an include and if the carrier match ever stops discriminating between carrier strings. Recall cannot see either direction: the must_exist row above matches whether or not the matcher is too permissive." }
  ]
}
